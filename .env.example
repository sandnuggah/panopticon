# Copy to .env and fill in. .env is gitignored; never commit real values.

# Base URL of your Traccar server, as this app's server reaches it.
# In Docker this can be the internal address, e.g. http://traccar:8082
TRACCAR_URL=

# Where browsers reach Traccar's own UI, for links in Traccar's emails.
# Only needed when it differs from TRACCAR_URL, e.g. https://traccar.example.com
# TRACCAR_PUBLIC_URL=

# At least 32 random characters. Encrypts the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# How people may sign in: sso (single sign-on through Traccar), password, or sso,password (the
# default). The sign-in page offers only these, and the server refuses the others.
# SIGN_IN_METHODS=sso,password

# How many days a sign-in lasts before you have to sign in again. Default 30.
# SESSION_DAYS=30

# maplibre style JSON. Default: OpenFreeMap's bright style (free, no key, no analytics).
# Point it at your own tile server's style to avoid any third-party requests.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# Extra origins the map may load tiles, fonts or sprites from, comma-separated, when your
# style uses hosts other than its own (the Content-Security-Policy blocks everything else).
# MAP_EXTRA_ORIGINS=https://fonts.example.com

# A Valhalla routing service for Snap to paths: walks on the trail are snapped to streets and paths.
# Optional; without it the setting isn't offered. Trail points only go to this address.
# MAP_MATCHING_URL=http://valhalla:8002

# A Nominatim server for finding places by address in the place editor (Find on the map). Optional;
# without it you place the circle by hand. Only what's typed into the search goes to this address:
# your own Nominatim, or a public one whose terms allow it.
# GEOCODER_URL=http://nominatim:8080

# Alerts: what Traccar sends with its forwarded events (event.forward.header in traccar.xml), so
# only it can trigger notifications. Optional; without it, alerts aren't offered. See the README.
# Generate one with: openssl rand -hex 24
# TRACCAR_EVENTS_SECRET=
