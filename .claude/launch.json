{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "panopticon",
      "runtimeExecutable": "/etc/profiles/per-user/adam/bin/mise",
      "runtimeArgs": ["exec", "--", "npm", "run", "dev"],
      "port": 3000
    },
    {
      "name": "panopticon-lan",
      "runtimeExecutable": "/etc/profiles/per-user/adam/bin/mise",
      "runtimeArgs": ["exec", "--", "npm", "run", "dev", "--", "--host"],
      "port": 3000
    },
    {
      "name": "panopticon-mock",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "TRACCAR_URL=http://127.0.0.1:8082",
        "MAP_MATCHING_URL=http://127.0.0.1:8002",
        "GEOCODER_URL=http://127.0.0.1:8082",
        "TRACCAR_EVENTS_SECRET=mock-only-events-secret-not-for-real-use",
        "/etc/profiles/per-user/adam/bin/mise",
        "exec",
        "--",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "panopticon-prod-mock",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "TRACCAR_URL=http://127.0.0.1:8082",
        "MAP_MATCHING_URL=http://127.0.0.1:8002",
        "GEOCODER_URL=http://127.0.0.1:8082",
        "PORT=3002",
        "SESSION_SECRET=mock-only-session-secret-not-for-real-use-0123456789",
        "/etc/profiles/per-user/adam/bin/mise",
        "exec",
        "--",
        "node",
        "server.mjs"
      ],
      "port": 3002
    }
  ]
}
