# Copy to .env next to compose.yaml on the server and fill in. Never commit .env.

# The image to run, e.g. ghcr.io/<github-user>/panopticon:latest, or a number such as :9 to pin a release
PANOPTICON_IMAGE=

# At least 32 random characters. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Traccar's Docker network (docker network ls). Usually <traccar project name>_default.
TRACCAR_NETWORK=traccar_default

# How panopticon reaches Traccar on that network. Default: http://traccar:8082
# TRACCAR_URL=http://traccar:8082

# Traccar's public address, for links in Traccar's emails, e.g. https://traccar.example.com
# Leave empty if Traccar's web UI isn't reachable from outside.
TRACCAR_PUBLIC_URL=

# Optional; see the repository's .env.example for details.
# SESSION_DAYS=30
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_EXTRA_ORIGINS=
# MAP_MATCHING_URL=http://valhalla:8002

# Alerts: what Traccar sends with its forwarded events (see README.md → Alerts). Optional.
# Generate with: openssl rand -hex 24
# TRACCAR_EVENTS_SECRET=
